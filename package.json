{
  "name": "openstrut",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "build:pages": "OPENSTRUT_BASE=/openstrut/ bun run build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "preview:pages": "OPENSTRUT_BASE=/openstrut/ vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.55.0",
    "modern-screenshot": "^4.7.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.41",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
